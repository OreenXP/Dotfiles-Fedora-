[Unit]
Description=Bloqueo de pantalla antes de suspender
Documentation=man:swayidle(1)
PartOf=hyprland-session.target
After=hyprland-session.target

[Service]
Type=simple
ExecStart=/usr/bin/swayidle -C %h/.config/swayidle/config
Restart=on-failure
RestartSec=1

[Install]
WantedBy=hyprland-session.target
