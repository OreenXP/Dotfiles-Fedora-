{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups"
  ],
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "spacing": 4,
  "margin-left": 8,
  "margin-right": 8,
  "margin-top": 6,
  "modules-left": [
    "hyprland/workspaces#rw",
    "custom/keybinds",
    "tray",
    "custom/media-icon",
    "custom/media-status",
    "custom/media-prev",
    "custom/media-toggle",
    "custom/media-next"
  ],
  "modules-center": [
    "clock#2",
    "custom/notification"
  ],
  "modules-right": [
    "hyprland/window",
    "group/mobo_drawer",
    "network",
    "bluetooth",
    "battery",
    "custom/power"
  ],
  "height": 26
}
