{
  "custom/keybinds": {
    "format": "",
    "tooltip-format": "Ver atajos de teclado (SUPER + C)",
    "on-click": "sh ~/.config/rofi/scripts/shortcuts.sh"
  },
  "custom/mako": {
    "format": "",
    "tooltip-format": "Notificaciones: clic para cerrar; clic derecho para recuperar la última",
    "on-click": "makoctl dismiss -a",
    "on-click-right": "makoctl restore"
  },
  "custom/power": {
    "format": "",
    "tooltip-format": "Opciones de sesión",
    "on-click": "sh ~/.config/waybar/scripts/power-menu.sh"
  }
}
